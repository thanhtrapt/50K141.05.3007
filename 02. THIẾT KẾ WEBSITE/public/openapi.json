    "/api/files/images": {
      "post": {
        "tags": [
          "Khách hàng và liệu trình"
        ],
        "summary": "Tải ảnh lên (multipart/form-data hoặc base64 JSON; tối đa 8 MB)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "base64",
                  "mimeType"
                ],
                "properties": {
                  "base64": {
                    "type": "string",
                    "contentEncoding": "base64"
                  },
                  "mimeType": {
                    "type": "string",
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
