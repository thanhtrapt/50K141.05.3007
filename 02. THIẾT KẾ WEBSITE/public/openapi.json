        ],
        "summary": "Tạo lịch hẹn (OWNER)",
        "x-required-role": "OWNER",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "customerId",
                  "sessionId",
                  "date",
                  "startTime"
                ],
                "properties": {
                  "customerId": {
                    "type": "string"
                  },
                  "sessionId": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "startTime": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9]$"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Success"
