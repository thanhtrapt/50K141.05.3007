  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT lấy từ POST /api/auth/login."
      },
      "webhookSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "Giá trị N8N_WEBHOOK_SECRET được đặt trong Authorization: Bearer ...; token hành động cũng cần nằm trong body."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PackageId": {
        "name": "packageId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SessionId": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Keyword": {
        "name": "keyword",
        "in": "query",
        "schema": {
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "Login": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "phone",
                "password"
              ],
              "properties": {
                "phone": {
                  "type": "string",
                  "pattern": "^0[0-9]{9}$",
                  "example": "0912345678"
                },
                "password": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 20
                }
              }
            }
          }
        }
      },
      "Service": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "price",
                "sessions"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "integer",
                  "minimum": 1
                },
                "totalSessions": {
                  "type": "integer",
                  "minimum": 1
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "technique",
                      "durationMinutes",
                      "cosmeticsUsage"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "technique": {
                        "type": "string"
                      },
                      "durationMinutes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "cosmeticsUsage": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Customer": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "phone",
                "dateOfBirth"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 50
                },
                "phone": {
                  "type": "string",
                  "pattern": "^0[0-9]{9}$"
                },
                "dateOfBirth": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "Cosmetic": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "name",
                "category",
                "unit",
                "salePrice"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Bán lẻ",
                    "Dùng cho liệu trình"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "salePrice": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "Review": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "customerId",
                "servicePackageId",
                "rating",
                "content"
              ],
              "properties": {
                "customerId": {
                  "type": "string"
                },
                "servicePackageId": {
                  "type": "string"
                },
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "content": {
                  "type": "string",
                  "maxLength": 200
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 255
                }
              }
            }
          }
        }
      },
      "ReviewWebhook": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "reviewToken",
                "rating",
                "content"
              ],
              "properties": {
                "reviewToken": {
                  "type": "string"
                },
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "content": {
                  "type": "string",
                  "maxLength": 200
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Yêu cầu thành công",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiSuccess"
            }
          }
        }
      },
      "Error": {
        "description": "Lỗi yêu cầu",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "OK"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
