    {"parameters":{"jsCode":"const token=String($json.query?.token??'').replace(/[^A-Za-z0-9._-]/g,''); const action=String($env.N8N_PUBLIC_BASE_URL||'').replace(/\\/$/,'')+'/webhook/zalo/review-submitted'; const html='<!doctype html><html lang=\\\"vi\\\"><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>Đánh giá Hương Spa</title><body style=\\\"font-family:Arial,sans-serif;max-width:560px;margin:32px auto;padding:20px;color:#382b25\\\"><h2>Đánh giá dịch vụ Hương Spa</h2><form method=\\\"post\\\" action=\\\"'+action+'\\\"><input type=\\\"hidden\\\" name=\\\"reviewToken\\\" value=\\\"'+token+'\\\"><label>Mức đánh giá (1–5 sao)<br><select name=\\\"rating\\\" required><option value=\\\"5\\\">5 sao</option><option value=\\\"4\\\">4 sao</option><option value=\\\"3\\\">3 sao</option><option value=\\\"2\\\">2 sao</option><option value=\\\"1\\\">1 sao</option></select></label><p><label>Nội dung đánh giá<br><textarea name=\\\"content\\\" maxlength=\\\"200\\\" required style=\\\"width:100%;height:120px\\\"></textarea></label></p><label>Đường dẫn ảnh (không bắt buộc)<br><input name=\\\"image\\\" type=\\\"url\\\" maxlength=\\\"255\\\" style=\\\"width:100%\\\"></label><p><button type=\\\"submit\\\">Gửi đánh giá</button></p></form></body></html>'; return [{json:{html}}];"},"id":"hs-review-html","name":"Tạo trang đánh giá","type":"n8n-nodes-base.code","typeVersion":2,"position":[260,920]},
