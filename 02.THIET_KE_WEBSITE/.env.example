# Sao chép tệp này thành `.env` ở thư mục gốc khi phát triển cục bộ.
# Trên Vercel, khai báo đúng các biến này trong Settings > Environment Variables.
# Không đặt tiền tố VITE_ cho bất kỳ biến nào của backend: Frontend luôn gọi `/api/...`
# cùng domain nên không cần URL backend riêng.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Bắt buộc đổi trước khi chạy production (tối thiểu 32 ký tự ngẫu nhiên).
JWT_SECRET=replace-with-at-least-32-random-characters-before-deployment
JWT_EXPIRES_IN=8h

# windows: dùng Windows Authentication (chỉ chạy được trên máy Windows có ODBC Driver 18).
# sql: dùng tài khoản SQL, driver thuần JS nên chạy được trên Vercel/Linux.
SQL_AUTH=windows
SQL_SERVER=LAPTOP-1BA3GF37\SQLEXPRESS
# Để trống khi kết nối qua named instance.
SQL_PORT=
SQL_DATABASE=HuongSpaDB
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERT=true
# Số kết nối tối đa cho mỗi function instance (mặc định 3 khi chạy trên Vercel).
SQL_POOL_MAX=

# Tự chạy migration + seed ở lần kết nối CSDL đầu tiên của mỗi instance.
# Đặt false trên production sau khi đã chạy `npm run migrate` và `npm run seed`.
AUTO_SETUP=true

# Thư mục lưu ảnh/PDF. Trên Vercel mặc định là thư mục tạm của function.
UPLOAD_DIR=./public/uploads
# Giới hạn kích thước body API (byte). Mặc định 12 MB cục bộ, 4 MB trên Vercel
# vì nền tảng chặn request lớn hơn khoảng 4,5 MB.
MAX_BODY_BYTES=
PUBLIC_BASE_URL=http://localhost:4000
PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
PDF_BOLD_FONT_PATH=C:/Windows/Fonts/arialbd.ttf

N8N_WEBHOOK_BASE_URL=
N8N_PUBLIC_BASE_URL=
N8N_WEBHOOK_SECRET=replace-with-the-same-random-secret-configured-in-n8n
N8N_MAX_RETRIES=5

# Bí mật cho endpoint tác vụ định kỳ /api/jobs/tick (mặc định dùng N8N_WEBHOOK_SECRET).
JOBS_SECRET=

SEED_OWNER_PHONE=0912345678
SEED_OWNER_PASSWORD=chuspa123
SEED_OWNER_NAME=Lê Thị Thu Hương
SEED_STAFF_PHONE=0901234567
SEED_STAFF_PASSWORD=nhanvien123
SEED_STAFF_NAME=Nhân viên Hương Spa
